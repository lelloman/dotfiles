{
  "version": 1,
  "terminal": "gnome-terminal",
  "preferred_outputs": {
    "primary": "DP-0",
    "secondary": "HDMI-0"
  },
  "startup_workspace": "1",
  "workspaces": [
    {
      "name": "1",
      "output": "primary",
      "layout": "none",
      "applications": [
        {
          "name": "Chromium",
          "command": "chromium",
          "match_field": "class",
          "match": "^Chromium$",
          "launch": true,
          "assign": true
        }
      ]
    },
    {
      "name": "4",
      "output": "primary",
      "layout": "none",
      "applications": [
        {
          "name": "Ronomepo",
          "command": "cargo run --release -- /home/lelloman/lelloprojects",
          "working_directory": "$HOME/lelloprojects/ronomepo",
          "match_field": "title",
          "match": "Ronomepo",
          "launch": true,
          "assign": false,
          "launch_timeout": 120
        }
      ]
    }
  ],
  "templates": [
    {
      "name": "project-terminals",
      "parameters": [
        "path"
      ],
      "workspace": {
        "output": "secondary",
        "layout": "custom",
        "layout_tree": {
          "type": "split",
          "orientation": "horizontal",
          "children": [
            {
              "type": "app"
            },
            {
              "type": "split",
              "orientation": "vertical",
              "children": [
                {
                  "type": "app"
                },
                {
                  "type": "app"
                }
              ]
            }
          ]
        },
        "applications": [
          {
            "name": "Terminal 1",
            "command": "gnome-terminal",
            "working_directory": "{{path}}",
            "match_field": "class",
            "match": "^Gnome-terminal$",
            "launch": true,
            "assign": false
          },
          {
            "name": "Terminal 2",
            "command": "gnome-terminal",
            "working_directory": "{{path}}",
            "match_field": "class",
            "match": "^Gnome-terminal$",
            "launch": true,
            "assign": false
          },
          {
            "name": "Terminal 3",
            "command": "gnome-terminal",
            "working_directory": "{{path}}",
            "match_field": "class",
            "match": "^Gnome-terminal$",
            "launch": true,
            "assign": false
          }
        ]
      }
    }
  ],
  "materializations": []
}

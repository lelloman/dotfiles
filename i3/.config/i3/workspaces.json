{
  "version": 1,
  "terminal": "gnome-terminal",
  "preferred_outputs": {
    "primary": "HDMI-0",
    "secondary": "DP-0"
  },
  "startup_workspace": "1",
  "workspaces": [
    {
      "name": "1",
      "output": "primary",
      "layout": "none",
      "applications": [
        {
          "name": "Chromium",
          "command": "chromium",
          "match_field": "class",
          "match": "^Chromium$",
          "launch": true,
          "assign": true
        }
      ]
    },
    {
      "name": "2",
      "output": "primary",
      "layout": "none",
      "applications": [
        {
          "name": "Visual Studio Code",
          "command": "code",
          "match_field": "class",
          "match": "^Code$",
          "launch": false,
          "assign": true
        }
      ]
    },
    {
      "name": "4",
      "output": "primary",
      "layout": "none",
      "applications": [
        {
          "name": "Ronomepo",
          "command": "cargo run --release -- /home/lelloman/lelloprojects",
          "working_directory": "$HOME/lelloprojects/ronomepo",
          "match_field": "title",
          "match": "Ronomepo",
          "launch": true,
          "assign": false
        }
      ]
    },
    {
      "name": "5",
      "output": "primary",
      "layout": "none",
      "applications": [
        {
          "name": "Android Studio",
          "command": "studio",
          "match_field": "class",
          "match": "^jetbrains-studio$",
          "launch": false,
          "assign": true
        }
      ]
    }
  ],
  "templates": [
    {
      "name": "project-terminals",
      "parameters": ["path"],
      "workspace": {
        "output": "secondary",
        "layout": "custom",
        "layout_tree": {
          "type": "split",
          "orientation": "horizontal",
          "children": [
            { "type": "app" },
            {
              "type": "split",
              "orientation": "vertical",
              "children": [
                { "type": "app" },
                { "type": "app" }
              ]
            }
          ]
        },
        "applications": [
          { "name": "Terminal 1", "command": "gnome-terminal", "working_directory": "{{path}}", "match_field": "class", "match": "^Gnome-terminal$", "launch": true, "assign": false },
          { "name": "Terminal 2", "command": "gnome-terminal", "working_directory": "{{path}}", "match_field": "class", "match": "^Gnome-terminal$", "launch": true, "assign": false },
          { "name": "Terminal 3", "command": "gnome-terminal", "working_directory": "{{path}}", "match_field": "class", "match": "^Gnome-terminal$", "launch": true, "assign": false }
        ]
      }
    }
  ],
  "materializations": [
    { "template": "project-terminals", "workspace": "rns", "parameters": { "path": "/home/lelloman/lelloprojects/rns-rs" } },
    { "template": "project-terminals", "workspace": "crumbles", "parameters": { "path": "/home/lelloman/lelloprojects/crumbles" } },
    { "template": "project-terminals", "workspace": "homelab", "parameters": { "path": "/home/lelloman/lelloprojects/homelab" } },
    { "template": "project-terminals", "workspace": "lellostore", "parameters": { "path": "/home/lelloman/lelloprojects/lellostore" } },
    { "template": "project-terminals", "workspace": "34", "parameters": { "path": "$HOME/lelloprojects" } },
    { "template": "project-terminals", "workspace": "35", "parameters": { "path": "$HOME/lelloprojects" } }
  ]
}

#!/usr/bin/env python3
"""Add clickable workspace and volume controls to an i3status stream."""

from __future__ import annotations

import json
import os
import re
import signal
import subprocess
import sys
import threading
from typing import Any


CONTROL_BLOCKS = [
    {"name": "project", "full_text": "+ project", "color": "#8ec07c"},
    {"name": "reset", "full_text": "reset", "color": "#fabd2f"},
]
CONTROL_NAMES = {block["name"] for block in CONTROL_BLOCKS}


def pactl(*args: str) -> str:
    return subprocess.check_output(
        ["pactl", *args], text=True, stderr=subprocess.DEVNULL,
        env={**os.environ, "LC_ALL": "C"}, timeout=2,
    )


def volume_blocks() -> list[dict[str, Any]]:
    try:
        volume = re.search(r"(\d+)%", pactl("get-sink-volume", "@DEFAULT_SINK@"))
        if volume is None:
            raise ValueError("No volume reported")
        muted = pactl("get-sink-mute", "@DEFAULT_SINK@").strip() == "Mute: yes"
        label = "🔇 muted" if muted else f"🔊 {volume.group(1)}%"
        color = "#fabd2f" if muted else "#8ec07c"
    except (OSError, subprocess.SubprocessError, ValueError):
        label, color = "🔊 unavailable", "#928374"
    return [
        {"name": "volume_down", "full_text": "−", "separator": False},
        {"name": "volume", "full_text": label, "color": color, "separator": False},
        {"name": "volume_up", "full_text": "+"},
    ]


def volume_action(event: dict[str, Any]) -> list[str] | None:
    name, button = event.get("name"), event.get("button")
    if name not in ("volume", "volume_down", "volume_up"):
        return None
    if button == 4 or (name == "volume_up" and button == 1):
        return ["set-sink-volume", "@DEFAULT_SINK@", "+5%"]
    if button == 5 or (name == "volume_down" and button == 1):
        return ["set-sink-volume", "@DEFAULT_SINK@", "-5%"]
    if name == "volume" and button == 1:
        return ["set-sink-mute", "@DEFAULT_SINK@", "toggle"]
    return None


def augment_update(line: str) -> str:
    stripped = line.strip()
    prefix = "," if stripped.startswith(",") else ""
    payload = stripped[1:] if prefix else stripped
    blocks = json.loads(payload)
    return prefix + json.dumps(CONTROL_BLOCKS + volume_blocks() + blocks, separators=(",", ":"))


def click_name(line: str) -> str | None:
    payload = line.strip().lstrip(",")
    if not payload or payload in ("[", "]"):
        return None
    event: dict[str, Any] = json.loads(payload)
    name = event.get("name")
    if event.get("button") == 1 and name in CONTROL_NAMES:
        return str(name)
    return None


def handle_clicks(status: subprocess.Popen) -> None:
    control = os.path.expanduser("~/.local/bin/i3bar-control")
    for line in sys.stdin:
        try:
            payload = line.strip().lstrip(",")
            if not payload or payload in ("[", "]"):
                continue
            event = json.loads(payload)
            if not isinstance(event, dict):
                continue
            action = volume_action(event)
            if action:
                pactl(*action)
                status.send_signal(signal.SIGUSR1)
                continue
            name = click_name(line)
        except (json.JSONDecodeError, TypeError, OSError, subprocess.SubprocessError):
            continue
        if name:
            subprocess.Popen(
                [control, name],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )


def main() -> int:
    status = subprocess.Popen(
        ["i3status", "-c", os.path.expanduser("~/.config/i3/i3status.conf")],
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    def stop(_signum: int, _frame: Any) -> None:
        status.terminate()
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    assert status.stdout is not None
    first_line = status.stdout.readline()
    if not first_line:
        return status.wait() or 1
    header = json.loads(first_line)
    header["click_events"] = True
    print(json.dumps(header, separators=(",", ":")), flush=True)
    print(status.stdout.readline().strip(), flush=True)
    threading.Thread(target=handle_clicks, args=(status,), daemon=True).start()

    try:
        for line in status.stdout:
            try:
                print(augment_update(line), flush=True)
            except (json.JSONDecodeError, TypeError):
                continue
    finally:
        status.terminate()
    return status.wait()


if __name__ == "__main__":
    raise SystemExit(main())

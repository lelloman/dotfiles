#!/bin/bash

set -u

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG_FILE="$LOG_DIR/sway-startup.log"

mkdir -p "$LOG_DIR"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

run_step() {
    local name="$1"
    shift
    local status

    log "starting $name"
    "$@" >> "$LOG_FILE" 2>&1
    status=$?
    log "finished $name status=$status"
    return "$status"
}

log "startup begin"

run_step confmonitor-sway "$HOME/.local/bin/confmonitor-sway"

# Give Sway/wlroots a moment to observe the output layout before assigning workspaces.
sleep 1

run_step setupworkspaces-sway "$HOME/.local/bin/setupworkspaces-sway"

log "startup end"

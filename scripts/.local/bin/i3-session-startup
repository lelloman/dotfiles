#!/bin/bash

set -u

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG_FILE="$LOG_DIR/i3-startup.log"

mkdir -p "$LOG_DIR"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

run_step() {
    local name="$1"
    shift
    local status

    log "starting $name"
    "$@" >> "$LOG_FILE" 2>&1
    status=$?
    log "finished $name status=$status"
    return "$status"
}

log "startup begin"

run_step confmonitor "$HOME/.local/bin/confmonitor"

# Give i3/XRandR a moment to observe the output layout before assigning workspaces.
sleep 1

run_step setupworkspaces "$HOME/.local/bin/setupworkspaces"

log "startup end"

#!/usr/bin/env python3
"""Run Codex with terminal notifications mapped to X11 window urgency."""
import fcntl
import os
import pty
import shutil
import signal
import struct
import subprocess
import sys
import termios


class BellDetector:
    """Distinguish notification BEL from BEL terminating an OSC title update."""
    def __init__(self):
        self.state = 'normal'
        self.osc = False

    def feed(self, data):
        bell = False
        for byte in data:
            if self.state == 'normal':
                if byte == 7:
                    bell = True
                elif byte == 27:
                    self.state = 'escape'
            elif self.state == 'escape':
                if byte in b']P_X^':
                    self.osc = byte == ord(']')
                    self.state = 'string'
                else:
                    self.state = 'escape' if byte == 27 else 'normal'
            elif self.state == 'string':
                if byte == 7 and self.osc:
                    self.state = 'normal'
                elif byte == 27:
                    self.state = 'string_escape'
            elif self.state == 'string_escape':
                if byte == 92 or (byte == 7 and self.osc):
                    self.state = 'normal'
                elif byte != 27:
                    self.state = 'string'
        return bell


def main():
    command = shutil.which('codex')
    if not command:
        sys.exit('codex is not on PATH')
    if not sys.stdin.isatty() or not sys.stdout.isatty() or not os.environ.get('DISPLAY'):
        os.execv(command, [command, *sys.argv[1:]])
    try:
        window = os.environ.get('WINDOWID') or subprocess.check_output(
            ['xdotool', 'getactivewindow'], text=True).strip()
        int(window, 0)
    except (OSError, ValueError, subprocess.CalledProcessError):
        os.execv(command, [command, *sys.argv[1:]])

    detector = BellDetector()
    master = None
    def resize(*_):
        if master is not None:
            size = fcntl.ioctl(0, termios.TIOCGWINSZ, struct.pack('HHHH', 0, 0, 0, 0))
            fcntl.ioctl(master, termios.TIOCSWINSZ, size)
    def read(fd):
        nonlocal master
        if master is None:
            master = fd
            resize()
        data = os.read(fd, 65536)
        if detector.feed(data):
            subprocess.run(['xdotool', 'set_window', '--urgency', '1', window],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return data
    signal.signal(signal.SIGWINCH, resize)
    try:
        # Force BEL notifications for this launcher, independent of terminal autodetection.
        status = pty.spawn([command, '-c', 'tui.notifications=true', '-c',
                            'tui.notification_method="bel"', '-c',
                            'tui.notification_condition="unfocused"',
                            *sys.argv[1:]], master_read=read)
    finally:
        subprocess.run(['xdotool', 'set_window', '--urgency', '0', window],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return os.waitstatus_to_exitcode(status)


if __name__ == '__main__':
    sys.exit(main())

#!/bin/bash

set -euo pipefail

# i3 workspace setup using append_layout for reliable window placement
#
# Prerequisites:
# - ~/.config/i3/config must include: include ~/.config/i3/workspace-assigns.conf
# - Run: i3-msg reload (or restart i3) after first setup

# =============================================================================
# CONFIGURATION
# =============================================================================

TERMINAL="gnome-terminal"
LAYOUT_DIR="$HOME/.config/i3/layouts"
MONITOR_CONF="$HOME/.config/i3/workspace-monitors.conf"
GRID_LAYOUT="$LAYOUT_DIR/terminals-2x2.json"
TWOCOL_LAYOUT="$LAYOUT_DIR/terminals-side-by-side.json"

TERM_PATH_TOP_LEFT="$HOME/lelloprojects"
TERM_PATH_TOP_RIGHT="$HOME/lelloprojects"
TERM_PATH_BOTTOM_LEFT="$HOME/lelloprojects"
TERM_PATH_BOTTOM_RIGHT="$HOME/lelloprojects"
SPECIAL_TERM_PATH="$HOME/lelloprojects/ronomepo"
SPECIAL_TERM_COMMAND='cargo run --release -- ../'

GRID_WORKSPACES=(31 32 33 34 35)
TWOCOL_WORKSPACES=(6)
SPECIAL_WORKSPACE=4

# Workspace groups used for automatic monitor assignment.
PRIMARY_WORKSPACES=(1 2 4 5 6)
SECONDARY_WORKSPACES=(31 32 33 34 35)

# Preferred output names. If they are not connected, the script falls back to
# the first and second active outputs reported by i3.
PREFERRED_PRIMARY_OUTPUT="DP-0"
PREFERRED_SECONDARY_OUTPUT="HDMI-0"

# =============================================================================
# MONITOR FUNCTIONS
# =============================================================================

write_monitor_bindings() {
    local assignments="$1"

    if [ -z "$assignments" ]; then
        return 0
    fi

    echo "Configuring workspace-to-monitor bindings..."
    echo "# Workspace to monitor bindings (auto-generated by setupworkspaces)" > "$MONITOR_CONF"
    echo "# Generated: $(date)" >> "$MONITOR_CONF"

    for pair in $assignments; do
        local ws="${pair%%:*}"
        local monitor="${pair#*:}"
        echo "  Workspace $ws -> $monitor"
        echo "workspace \"$ws\" output $monitor" >> "$MONITOR_CONF"
    done

    # Reload i3 to apply changes
    i3-msg reload >/dev/null
}

output_is_active() {
    local output="$1"
    shift
    local active_output

    for active_output in "$@"; do
        if [ "$active_output" = "$output" ]; then
            return 0
        fi
    done

    return 1
}

append_workspace_assignments() {
    local output="$1"
    shift
    local ws

    for ws in "$@"; do
        printf '%s:%s ' "$ws" "$output"
    done
}

detect_monitor_assignments() {
    local active_outputs_json
    local active_outputs
    local output_count
    local primary_output
    local secondary_output
    local active_output
    local assignments=""

    active_outputs_json=$(i3-msg -t get_outputs)
    mapfile -t active_outputs < <(echo "$active_outputs_json" | jq -r '.[] | select(.active == true) | .name')
    output_count="${#active_outputs[@]}"

    if [ "$output_count" -eq 0 ]; then
        echo "Error: No active i3 outputs found" >&2
        exit 1
    fi

    if output_is_active "$PREFERRED_PRIMARY_OUTPUT" "${active_outputs[@]}"; then
        primary_output="$PREFERRED_PRIMARY_OUTPUT"
    elif [ "$output_count" -gt 1 ] && output_is_active "$PREFERRED_SECONDARY_OUTPUT" "${active_outputs[@]}"; then
        for active_output in "${active_outputs[@]}"; do
            if [ "$active_output" != "$PREFERRED_SECONDARY_OUTPUT" ]; then
                primary_output="$active_output"
                break
            fi
        done
    else
        primary_output="${active_outputs[0]}"
    fi

    if [ "$output_count" -eq 1 ]; then
        assignments+="$(append_workspace_assignments "$primary_output" "${PRIMARY_WORKSPACES[@]}" "${SECONDARY_WORKSPACES[@]}")"
        echo "$assignments"
        return 0
    fi

    if [ "$primary_output" != "$PREFERRED_SECONDARY_OUTPUT" ] && output_is_active "$PREFERRED_SECONDARY_OUTPUT" "${active_outputs[@]}"; then
        secondary_output="$PREFERRED_SECONDARY_OUTPUT"
    else
        for active_output in "${active_outputs[@]}"; do
            if [ "$active_output" != "$primary_output" ]; then
                secondary_output="$active_output"
                break
            fi
        done
    fi

    assignments+="$(append_workspace_assignments "$primary_output" "${PRIMARY_WORKSPACES[@]}")"
    assignments+="$(append_workspace_assignments "$secondary_output" "${SECONDARY_WORKSPACES[@]}")"
    echo "$assignments"
}

check_requirements() {
    local missing=0

    if ! command -v i3-msg >/dev/null 2>&1; then
        echo "Error: i3-msg is not installed"
        missing=1
    fi

    if ! command -v "$TERMINAL" >/dev/null 2>&1; then
        echo "Error: terminal command not found: $TERMINAL"
        missing=1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: jq is not installed"
        missing=1
    fi

    if ! command -v chromium >/dev/null 2>&1; then
        echo "Error: chromium is not installed"
        missing=1
    fi

    if ! command -v cargo >/dev/null 2>&1; then
        echo "Error: cargo is not installed"
        missing=1
    fi

    if [ ! -f "$GRID_LAYOUT" ]; then
        echo "Error: Missing $GRID_LAYOUT"
        missing=1
    fi

    if [ ! -f "$TWOCOL_LAYOUT" ]; then
        echo "Error: Missing $TWOCOL_LAYOUT"
        missing=1
    fi

    for path in \
        "$TERM_PATH_TOP_LEFT" \
        "$TERM_PATH_TOP_RIGHT" \
        "$TERM_PATH_BOTTOM_LEFT" \
        "$TERM_PATH_BOTTOM_RIGHT" \
        "$SPECIAL_TERM_PATH"; do
        if [ ! -d "$path" ]; then
            echo "Error: Missing working directory $path"
            missing=1
        fi
    done

    if [ "$missing" -ne 0 ]; then
        exit 1
    fi
}

# =============================================================================
# WORKSPACE SETUP FUNCTIONS
# =============================================================================

setup_terminal_grid() {
    local ws="$1"

    echo "  Workspace $ws: loading 2x2 layout..."
    i3-msg "workspace $ws" >/dev/null
    i3-msg "append_layout $GRID_LAYOUT" >/dev/null

    # Launch 4 terminals - they get swallowed into layout placeholders
    "$TERMINAL" --working-directory="$TERM_PATH_TOP_LEFT" &
    "$TERMINAL" --working-directory="$TERM_PATH_TOP_RIGHT" &
    "$TERMINAL" --working-directory="$TERM_PATH_BOTTOM_LEFT" &
    "$TERMINAL" --working-directory="$TERM_PATH_BOTTOM_RIGHT" &

    sleep 1
}

setup_terminal_2col() {
    local ws="$1"

    echo "  Workspace $ws: loading 2-column layout..."
    i3-msg "workspace $ws" >/dev/null
    i3-msg "append_layout $TWOCOL_LAYOUT" >/dev/null

    # Launch 2 terminals - they get swallowed into layout placeholders
    "$TERMINAL" --working-directory="$TERM_PATH_TOP_LEFT" &
    "$TERMINAL" --working-directory="$TERM_PATH_BOTTOM_LEFT" &

    sleep 1
}

setup_special_workspace() {
    local ws="$1"

    echo "  Workspace $ws: loading 2-column layout and launching ronomepo command..."
    i3-msg "workspace $ws" >/dev/null
    i3-msg "append_layout $TWOCOL_LAYOUT" >/dev/null

    "$TERMINAL" --working-directory="$SPECIAL_TERM_PATH" -- bash -lc "$SPECIAL_TERM_COMMAND; exec bash" &

    sleep 1
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    local monitor_assignments

    check_requirements

    # Configure monitor bindings
    monitor_assignments="$(detect_monitor_assignments)"
    write_monitor_bindings "$monitor_assignments"

    echo "Launching main applications (assign rules handle placement)..."
    echo "  Chromium -> workspace 1"
    chromium &

    echo "Setting up terminal workspaces (grid: ${GRID_WORKSPACES[*]}; 2-column: ${TWOCOL_WORKSPACES[*]}; special: $SPECIAL_WORKSPACE)..."
    for ws in "${GRID_WORKSPACES[@]}"; do
        setup_terminal_grid "$ws"
    done

    for ws in "${TWOCOL_WORKSPACES[@]}"; do
        setup_terminal_2col "$ws"
    done

    setup_special_workspace "$SPECIAL_WORKSPACE"

    i3-msg "workspace 1" >/dev/null
    echo "Done!"
}

main "$@"
